# Optional environment for the Zinester server.
# Copy to /etc/zinester.env (read by zinester.service) and fill in what you want.
# With none of these set, summaries stay dependency-free (feed blurb / extractive).

# Enable Claude-written summaries (used server-side, only when ingesting new items):
# ANTHROPIC_API_KEY=sk-ant-...

# Override the summary model (default: claude-haiku-4-5-20251001):
# ZINESTER_SUMMARY_MODEL=claude-haiku-4-5-20251001
